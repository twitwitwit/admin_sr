rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin Accounts collection
    match /adminAccounts/{id=**} {
      allow read, write: if true;
    }

    // Password Reset Reports collection
    match /passwordResetReports/{id=**} {
      allow read, write: if true;
    }

    // Passengers collection and any subcollections
    match /passengers/{id=**} {
      allow read, write: if true;
    }

    // Users collection and any subcollections (common auth/profile collection)
    match /users/{id=**} {
      allow read, write: if true;
    }

    // Riders collection and any subcollections (alternative passenger collection name)
    match /riders/{id=**} {
      allow read, write: if true;
    }

    // Drivers collection & subcollections (e.g. documents, requirements, audits)
    match /drivers/{id=**} {
      allow read, write: if true;
    }

    // Driver verification, applications, and requirements collections
    match /verifications/{id=**} {
      allow read, write: if true;
    }
    match /driverVerifications/{id=**} {
      allow read, write: if true;
    }
    match /driverApplications/{id=**} {
      allow read, write: if true;
    }
    match /driverRequirements/{id=**} {
      allow read, write: if true;
    }
    match /requirements/{id=**} {
      allow read, write: if true;
    }

    // Bookings collection and any subcollections
    match /bookings/{id=**} {
      allow read, write: if true;
    }

    // Emergency alerts collection
    match /emergencyAlerts/{id=**} {
      allow read, write: if true;
    }

    // Support tickets collection
    match /supportTickets/{id=**} {
      allow read, write: if true;
    }

    // System notifications collection
    match /systemNotifications/{id=**} {
      allow read, write: if true;
    }

    // Activity logs collection
    match /activityLogs/{id=**} {
      allow read, write: if true;
    }

    // Platform & System Settings document
    match /settings/{id=**} {
      allow read, write: if true;
    }

    // Test collection for initial connectivity checks
    match /test/{id=**} {
      allow read, write: if true;
    }

    // Fallback rule for any new collections added by connected Passenger & Driver apps
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
